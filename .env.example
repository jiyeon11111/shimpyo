# 복사해서 .env 로 쓰거나, 터미널에서 export 한다.
# 1 = 시연 모드 (2026-08-03 가상 기상·쉼터, 시각을 화면에서 조절) / 0 = 실제 모드
SHIMPYO_DEMO=1
SHIMPYO_DEMO_DATE=2026-08-03
SHIMPYO_DEMO_START=14:00
# 공공데이터포털 일반 인증키(Decoding). 기상청 단기예보(실제 모드 기온·습도)와 영향예보에 같이 쓴다
KMA_SERVICE_KEY=
# (선택) 기상청 영향예보 요청주소. 공공데이터포털 활용신청 상세 화면의 폭염 영향예보 요청주소를 그대로 넣는다
KMA_IMPACT_URL=
# 행정안전부 무더위쉼터 서비스 키. 재난안전데이터공유플랫폼(safetydata.go.kr)에서 받은 키 (scripts/fetch_heat_shelters.py)
SAFETYDATA_SHELTER_KEY=
# SQLite 파일 위치 (기본: backend/shimpyo.db)
SHIMPYO_DB=
# 카카오 로컬 API (쉼터 주소 → 위도·경도, scripts/geocode_shelters.py). 발급: developers.kakao.com
KAKAO_REST_KEY=
